# Local owner-key mode. Leave empty in the public visitor-key relay.
# Create a key at https://build.nvidia.com/ and keep it on the server.
NVIDIA_API_KEY=

# Optional server settings.
# PROXY_PORT=3011
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# ALLOWED_ORIGINS=https://your-demo.example
# TRUST_PROXY=true

# Public API relay for the GitHub Pages frontend. Set these on the API host.
# REQUIRE_USER_KEY=true
# SERVE_STATIC=false
# ALLOWED_ORIGINS=https://your-account.github.io

# Public frontend build settings; these contain no provider credentials.
# VITE_API_BASE_URL=https://your-api.example/api
# VITE_REQUIRE_USER_KEY=true
# BASE_PATH=/your-repository/
