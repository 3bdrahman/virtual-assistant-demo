{
  "name": "virtual-assistant",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names \"VITE,API\" --prefix-colors \"cyan,magenta\" \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "test:e2e": "node tests/demo.e2e.mjs",
    "test:avatar": "node tests/lipsync.e2e.mjs",
    "test:articulation": "node tests/articulation.e2e.mjs",
    "test:streaming": "node tests/streaming-speech.e2e.mjs",
    "test:pages": "node tests/pages.e2e.mjs",
    "test:public": "node tests/public-demo.e2e.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "verify": "npm test && npm run lint && npm run build",
    "build": "vite build",
    "lint": "oxlint"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
